# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local-only Codex notes, console evidence, and private operational material.
# Formal project decisions and sanitized runbooks belong in docs/ and are tracked.
/docs/local/
/docs/private/
/docs/evidence/
/docs/**/*.local.md
/docs/**/*-private.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
