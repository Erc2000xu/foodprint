# Public runtime configuration. Do not put secrets in NEXT_PUBLIC_* variables.
# Keep this Vercel URL until ICP filing and the Tencent Cloud cutover are complete.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_PROVIDER=amap
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact confirmed public website ICP filing number. A deployment override is
# accepted only when it matches this value.
NEXT_PUBLIC_ICP_RECORD=京ICP备2026047829号-1

# Written into the PWA service-worker URL to prevent stale bundles after a release.
DEPLOYMENT_VERSION=local

# Server-only configuration. Never commit the filled .env.local file.
AMAP_JS_KEY=
AMAP_SECURITY_KEY=
DISCOVERY_DYNAMIC_MAP_ENABLED=false
# A separate AMap Web Service Key for Supabase Edge Function Secrets only.
# Do not add this value to Vercel or a local Next.js runtime environment.
AMAP_WEBSERVICE_KEY=
# Encrypts active invitation tokens so Owners/Admins can retrieve links after refresh.
# Use a random secret of at least 32 characters; never expose or commit it.
INVITATION_TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PROVIDER=supabase
DATABASE_URL=

# Phase 1 bootstrap only; this is not a password and belongs in the local/private environment.
FOODPRINT_OWNER_EMAIL=owner@example.com
FOODPRINT_OWNER_PASSWORD=
FOODPRINT_GROUP_NAME=食迹 Foodprint
FOODPRINT_GROUP_SLUG=foodprint
