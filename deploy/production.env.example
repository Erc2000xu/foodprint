# Copy to /etc/foodprint/production.env on the server and set mode 0600.
# Do not commit a filled copy or paste secret values into chat.

# These public values are also required as Docker build arguments because
# Next.js inlines NEXT_PUBLIC_* values into the browser bundle.
NEXT_PUBLIC_APP_URL=https://foodprint.com.cn
NEXT_PUBLIC_MAP_PROVIDER=amap
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact confirmed public website ICP filing number. A deployment override is
# accepted only when it matches this value.
NEXT_PUBLIC_ICP_RECORD=京ICP备2026047829号-1

# Release metadata; the deployment process may override DEPLOYMENT_VERSION.
DEPLOYMENT_VERSION=v2

# Server-only values. Never expose them to the browser.
AMAP_JS_KEY=
AMAP_SECURITY_KEY=
DISCOVERY_DYNAMIC_MAP_ENABLED=true
INVITATION_TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PROVIDER=supabase

# Optional database connection value if a future server-side task requires it.
DATABASE_URL=
